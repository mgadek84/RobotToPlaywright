# -------------------------------------------------------
# Environment configuration — copy to .env and fill in
# Never commit .env to source control
# -------------------------------------------------------

# Application URL
EXAMPLE_LOGINPAGE_URL=https://your-app.example.com/#/

# UI test credentials (base64 encoded)
EXAMPLE_EMAIL=user@example.com
EXAMPLE_PASSWORD=<base64_encoded_password>
EXAMPLE_TWOFA=<base64_encoded_2fa_secret>

# API authentication
BEARER_TOKEN=<your_bearer_token>

# Browser configuration (Chrome | Firefox | Edge)
BROWSER=Chrome
RESOLUTION_HORIZONTAL=1920
RESOLUTION_VERTICAL=1080

# Test output
ROBOT_OUTPUTDIR=results
