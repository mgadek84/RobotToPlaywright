# -------------------------------------------------------
# Optional overrides. The suite runs without any of these:
# defaults live in config.properties/config.properties.robot.
#
# Robot Framework does not read .env files itself. A value takes effect only
# when it is set as an environment variable, e.g. by your IDE's env-file
# support or in PowerShell:  $env:HEADLESS = "true"
# Never commit .env to source control.
# -------------------------------------------------------

# API: https://reqres.in
REQRES_BASE_URL=https://reqres.in/api
REQRES_API_KEY=reqres-free-v1
REQRES_TIMEOUT=30

# UI: https://www.saucedemo.com (public demo credentials)
SAUCEDEMO_URL=https://www.saucedemo.com/
SAUCE_USER=standard_user
SAUCE_PASSWORD=secret_sauce

# Browser: chrome (default) or edge
UI_BROWSER=chrome
UI_TIMEOUT=10s
# true runs without a visible browser window
HEADLESS=false
